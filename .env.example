# Copy to .env.local and adjust once the Express backend (see /server) is running.

# When "true", pages call the real /api/* routes (via services/api.js) and
# fall back to the local digital-twin simulator only if that call fails.
# When "false" or unset, every page reads from the simulator via
# SimulationContext — this is the default so the frontend runs standalone.
VITE_USE_BACKEND=true

# Only needed when the client and server are deployed to different origins
# (e.g. client on Vercel, server on Render/Railway — see ../render.yaml and
# vercel.json). Leave unset for local dev, where Vite's proxy and a same-
# origin default handle both.
# VITE_API_BASE_URL=https://your-solarsense-server.onrender.com
# VITE_SOCKET_URL=https://your-solarsense-server.onrender.com
